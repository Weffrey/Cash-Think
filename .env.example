# Copy this file to .env.local and fill in the key. .env.local is ignored by git.
# The app runs without a key; only the AI chat and the Upgrade button need it.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Any chat model hosted by Groq. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Where the SQLite database lives. Default: data/app.db
# DB_PATH=data/app.db
